{
  "name": "nancy-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:verify",
    "build:verify": "node -e \"const fs=require('fs');const files=fs.readdirSync('dist/assets').filter(f=>f.endsWith('.js'));const found=files.some(f=>fs.readFileSync('dist/assets/'+f,'utf8').includes('placeholder.supabase'));if(found){console.error('BLOCKED: placeholder.supabase.co found in build output!');process.exit(1);}console.log('Build verified: no placeholder found.');\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/react-query": "^5.62.16",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.42.0",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.12.0",
    "papaparse": "^5.5.4",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.2.0",
    "wouter": "^3.3.5",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "drizzle-kit": "^0.30.6",
    "jsdom": "^30.0.1",
    "postgres": "^3.4.5",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
