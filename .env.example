# Nancy OS — Environment Variables Template
#
# Local development:
#   cp .env.example .env.local
#   Fill in your Supabase project values in .env.local
#
# Cloudflare Pages (production):
#   Go to Cloudflare Dashboard → Workers & Pages → nancy-os
#   Settings → Environment Variables → Production
#   Add VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY

# Supabase Project URL (required)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (required — public, safe to include)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Speech Recognition Provider
# Options: browser | aliyun | openai-whisper
VITE_SPEECH_PROVIDER=browser
